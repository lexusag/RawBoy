n) * 16 + i + n));\n    return (vec2(i, j) + r.xy - 0.5) * cell;\n}\n\n// Ratio chroma: a sample's chroma is scaled to the centre's luma level, (s - l) * (cl + k) / (l + k), so shading and\n// texture under strongly coloured light, which move every channel together, read as luma, not colour. As plain\n// differences they were smoothed as colour: under blue light a mono LUT showed the face as blotches.\nconst float CHROMA_RATIO_K = 0.02;\nvec3 chromaOf(vec3 s, float l, float cl) {\n    return (s - l) * ((cl + CHROMA_RATIO_K) / (l + CHROMA_RATIO_K));\n}\n\n// Lens shading gain the decoder applied at sensor position s (the luminance part of the DNG gain maps, 1 at the\n// map's centre), or 1 without a map. Phone DNGs carry one (Pixel 9 Pro main camera: up to ~3.4x in the corners).\nfloat shadingGainAt(vec2 s) {\n    if (uShadingPoints.x * uShadingPoints.y < 1.5) return 1.0;\n    vec2 rel = s / uSensorSize;                                      // (h, v) fractions\n    vec2 idx = (rel.yx - uShadingGrid.xy) / uShadingGrid.zw;         // (v, h) grid index\n    vec2 tc = (idx.yx + 0.5) / uShadingPoints.yx;                    // texture (h, v)\n    return max(texture(uShading, tc).r, 1e-3);\n}\n\n// The colour denoise's noise level at sensor position s, relative to the frame's centre. The decoder's lens shading\n// gain multiplied the corners' noise along with their light, so at the same output level they hold up to ~2x more\n// colour noise (in this sqrt domain: between sqrt(g) for shot noise and g for read noise; deep shadows are read\n// noise). One colour strength sized for the centre left the corners speckled; sized for the corners it washed out\n// the centre's colour detail. Luma denoise is not scaled.\nconst float COLOR_NOISE_SHADING_POW = 0.75;\nfloat colorNoiseScale(vec2 s) {\n    return pow(max(shadingGainAt(s), 1.0), COLOR_NOISE_SHADING_POW);\n}\n\n// [colorNoise]: colorNoiseScale at this pixel; multiplies the colour sigma only.\nvec3 denoise(vec2 uv, vec2 fullPx, vec3 rgb, float colorNoise) {\n    vec3 c = sqrt(max(rgb, 0.0));\n    float cl = (c.r + c.g + c.b) / 3.0;\n    vec3 cc = c - cl;\n\n    // Assumed noise std in sqrt space at full strength (~ISO 6400 on a typical\n    // sensor). The downscaled preview averages pixels, which lowers the noise.\n    float sigmaL = max(uDenoise * 0.03 * uPixelScale, 1e-5);\n    float sigmaC = max(uColorDenoise * 0.03 * uPixelScale * colorNoise, 1e-5);\n    float invLuma = 1.0 / (8.0 * sigmaL * sigmaL);    // range h = 2 sigma\n    float invLumaC = 1.0 / (8.0 * sigmaC * sigmaC);   // the chroma filter's luma edge guard\n    float invChroma = 1.0 / (18.0 * sigmaC * sigmaC); // range h = 3 sigma\n    vec2 px = uTexel * uPixelScale;                    // one full-res pixel in uv\n    ivec2 pix = ivec2(floor(fullPx));\n\n    float fineL = cl;\n    // After the wavelet pre-pass only the fine chroma stage runs (the coarse ones stay, gated, for high strength).\n    bool lumaHere = uDenoisePre < 0.5;\n    if (uDenoise > 0.0 && lumaHere) {\n        float lSum = 0.0;\n        float lW = 0.0;\n        for (int j = -2; j <= 2; ++j) {\n            for (int i = -2; i <= 2; ++i) {\n                vec3 s = sqrtSample(uv + vec2(i, j) * px);\n                float l = (s.r + s.g + s.b) / 3.0;\n                float d = l - cl;\n                float w = exp(-float(i * i + j * j) / 4.5 - d * d * invLuma);\n                lSum += l * w;\n                lW += w;\n            }\n        }\n        fineL = lSum / lW;\n    }\n\n    vec3 fineC = cc;\n    if (uColorDenoise > 0.0) {\n        vec3 cSum = vec3(0.0);\n        float cW = 0.0;\n        for (int j = -3; j <= 3; ++j) {\n            for (int i = -3; i <= 3; ++i) {\n                vec2 o = jitteredTap(i, j, 3, 9.0, pix, 0x51ed00u);\n                vec3 s = sqrtSample(uv + o * px);\n                float l = (s.r + s.g + s.b) / 3.0;\n                vec3 sc = chromaOf(s, l, cl);\n                vec3 dc = sc - cc;\n                float dl = l - cl;\n                float w = exp(-dot(o, o) / 72.0 - dl * dl * invLumaC * 0.5 - dot(dc, dc) * invChroma);\n                cSum += sc * w;\n                cW += w;\n            }\n        }\n        fineC = cSum / cW;\n    }\n\n    if (uDenoiseWide > 0.0 && lumaHere) {\n        float wlSum = 0.0;\n        float wlW = 0.0;\n        for (int j = -2; j <= 2; ++j) {\n            for (int i = -2; i <= 2; ++i) {\n                vec2 o = jitteredTap(i, j, 2, 6.0, pix, 0x2c1b00u);\n                vec3 s = sqrtSample(uv + o * px);\n                float l = (s.r + s.g + s.b) / 3.0;\n                float d = l - fineL;\n                float w = exp(-dot(o, o) / 40.5 - d * d * invLuma);\n                wlSum += l * w;\n                wlW += w;\n            }\n        }\n        fineL = mix(fineL, wlSum / wlW, uDenoiseWide);\n    }\n    if (uColorDenoiseWide > 0.0) {\n        vec3 wcSum = vec3(0.0);\n        float wcW = 0.0;\n        for (int j = -3; j <= 3; ++j) {\n            for (int i = -3; i <= 3; ++i) {\n                vec2 o = jitteredTap(i, j, 3, 18.0, pix, 0x9a3f00u);\n                vec3 s = sqrtSample(uv + o * px);\n                float l = (s.r + s.g + s.b) / 3.0;\n                vec3 sc = chromaOf(s, l, cl);\n                vec3 dc = sc - fineC;\n                float dl = l - fineL;\n                float w = exp(-dot(o, o) / 288.0 - dl * dl * invLumaC * 0.5 - dot(dc, dc) * invChroma);\n                wcSum += sc * w;\n                wcW += w;\n            }\n        }\n        // The coarse stages are for blotches in even areas: their leftover is faint next to the slider's noise level.\n        // A small feature with its own colour (an iris, a catchlight's rim) differs from its surroundings by much\n        // more, and averaging it with them turned blue-grey eyes brown. So each coarse stage moves the colour by its\n        // full amount only while the change is small (gate ~0.35 sigma, flat-topped), and leaves larger changes alone.\n        vec3 wc = wcSum / wcW - fineC;\n        float invGate = 1.0 / (2.0 * 0.35 * 0.35 * sigmaC * sigmaC);\n        float gw = dot(wc, wc) * invGate;\n        fineC += wc * (uColorDenoiseWide * exp(-gw * gw));\n\n        // Coarsest colour scale, from the 512 px base copy (~16 px per texel on a 50 MP raw, ~8 on a phone): colour\n        // blotches 20-100 px across outlive the 18 px stage, and raising the exposure turns them into blotchy\n        // patches. 7x7 texels at stride 1 (a sparser stride drew a 2-texel grid), Gaussian sigma ~1.8 texels.\n        // Range-weighted against the result so far, with tighter luma and colour guards than the other stages\n        // (the blotches are faint), so colour edges and small features (eyes, lips) stay. Skipped without a base\n        // copy (uBaseTexel 1).\n        vec2 buv = fullPx / uImageSize;\n        vec3 bSum = vec3(0.0);\n        float bW = 0.0;\n        for (int j = -3; j <= 3 && uBaseTexel.x < 0.5; ++j) {\n            for (int i = -3; i <= 3; ++i) {\n                vec3 s = sqrt(max(texture(uBase, buv + vec2(i, j) * uBaseTexel).rgb, 0.0));\n                float l = (s.r + s.g + s.b) / 3.0;\n                vec3 sc = chromaOf(s, l, cl);\n                vec3 dc = sc - fineC;\n                float dl = l - fineL;\n                float w = exp(-float(i * i + j * j) * 0.16 - dl * dl * invLumaC - dot(dc, dc) * invChroma * 4.0);\n                bSum += sc * w;\n                bW += w;\n            }\n        }\n        if (bW > 1e-4) {\n            vec3 bc = bSum / bW - fineC;\n            float gb = dot(bc, bc) * invGate;\n            fineC += bc * (uColorDenoiseWide * exp(-gb * gb));\n        }\n    }\n    // Ratio chroma was measured at the centre's luma: rescale it to the denoised luma.\n    fineC *= (fineL + CHROMA_RATIO_K) / (cl + CHROMA_RATIO_K);\n    vec3 outSqrt = max(vec3(fineL) + fineC, 0.0);\n    return outSqrt * outSqrt;\n}\n\n// Film-like grain, added in the log (density-like) domain.\n// Sparse convolution no