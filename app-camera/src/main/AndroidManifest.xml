<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Geotagging (Settings, off by default): asked for only when it is turned on. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Developing a shot takes ~3 s: keeps the process and CPU awake when the phone is locked right after shooting. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <!-- The location permissions would otherwise make GPS a required feature. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <!-- Develop pipeline runs as GLES 3.0 shaders (float textures, integer render targets). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Settings checks whether RawBoy Camera is the default camera, which needs the other cameras visible. -->
    <queries>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA_SECURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RawBoyCamera">

        <activity
            android:name=".CameraActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets the camera be picked as the default camera, which the power button's double press opens.
                 Unlocked phone: STILL_IMAGE_CAMERA; locked: STILL_IMAGE_CAMERA_SECURE, shown over the lock screen. -->
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Alias in case the system remembered LockScreenCameraActivity from a previous build. -->
        <activity-alias
            android:name=".LockScreenCameraActivity"
            android:targetActivity=".CameraActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Keeps the process and CPU awake while queued shots finish developing after the camera closes. -->
        <service
            android:name=".SaveService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>
</manifest>
