<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Geotagging (Settings, off by default): asked for only when it is turned on. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <!-- The location permissions would otherwise make GPS a required feature. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <!-- Develop pipeline runs as GLES 3.0 shaders (float textures, integer render targets). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Settings checks whether RawBoy Camera is the default camera, which needs the other cameras visible. -->
    <queries>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA_SECURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RawBoyCamera">

        <activity
            android:name=".CameraActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets the camera be picked as the default camera, which the power button's double press opens on an
                 unlocked phone (STILL_IMAGE_CAMERA). -->
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The double press on a locked phone (STILL_IMAGE_CAMERA_SECURE): its own task, apart from the ordinary
             camera's, and closed when the screen turns off, so each locked launch is a fresh camera over the lock
             screen. Sharing the ordinary task brought back whatever was on top of it (the photo viewer, or the
             camera from before the lock, neither allowed over the lock screen): a black screen. -->
        <activity
            android:name=".LockScreenCameraActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:taskAffinity=":lockscreen"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
